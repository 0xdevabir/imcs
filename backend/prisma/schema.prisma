generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReceiptStatus {
  DELIVERED
  READ
}

model ChatRoom {
  id        String           @id @default(cuid())
  key       String           @unique
  name      String?
  ownerUserId Int?
  ownerUsername String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  ChatMessage[]
  members   ChatRoomMember[]
  files     UploadedFile[]

  @@index([ownerUserId])
}

model ChatMessage {
  id               String            @id @default(cuid())
  roomId           String
  senderUserId     Int
  senderUsername   String
  content          String
  createdAt        DateTime          @default(now())
  deliveredAt      DateTime?
  readAt           DateTime?
  replyToMessageId String?
  room             ChatRoom          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  receipts         MessageReceipt[]
  reactions        MessageReaction[]
  replyTo          ChatMessage?      @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          ChatMessage[]     @relation("MessageReplies")

  @@index([roomId, createdAt])
  @@index([replyToMessageId])
}

model MessageReceipt {
  id         String        @id @default(cuid())
  messageId  String
  userId     Int
  username   String
  status     ReceiptStatus
  createdAt  DateTime      @default(now())
  message    ChatMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, status])
  @@index([messageId])
}

model ChatRoomMember {
  id        String   @id @default(cuid())
  roomId    String
  userId    Int
  username  String
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model UploadedFile {
  id             String   @id @default(cuid())
  roomId         String
  uploaderUserId Int
  uploaderName   String
  storedName     String   @unique
  originalName   String
  mimeType       String
  size           Int
  storagePath    String
  createdAt      DateTime @default(now())
  room           ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([uploaderUserId])
}

model MessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    Int
  username  String
  emoji     String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model CommunicationRule {
  id           String   @id @default(cuid())
  fromUsername String
  toUsername   String
  allowed      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([fromUsername, toUsername])
  @@index([fromUsername])
  @@index([toUsername])
}
