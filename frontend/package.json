{
  "name": "imcs-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:all": "concurrently \"cd ../backend && npm run start:dev\" \"npm run dev -- -p 3003\"",
    "test:e2e": "start-server-and-test 'npm run dev:all' http://localhost:3003 'playwright test --reporter=dot'"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "20.14.12",
    "@types/prop-types": "15.7.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "concurrently": "^9.2.1",
    "playwright": "^1.58.2",
    "postcss": "8.4.39",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4"
  }
}
